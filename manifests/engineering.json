              "ext_grid": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": [
                        "string",
                        "integer"
                      ]
                    },
                    "bus": {
                      "type": [
                        "string",
                        "integer"
                      ]
                    },
                    "vm_pu": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "va_degree": {
                      "type": "number"
