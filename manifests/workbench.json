    {
      "name": "WORKBENCH_ENERGY_OPERATION",
      "toolkit": "workbench",
      "description": "Filter, check missing intervals, convert counters, integrate power into energy, calculate tariff cost/carbon and explicit standing-charge/tax bills, reconcile declared solar load/generation, align, compare calendar periods or rolling baselines with strict units and lineage.",
      "input_schema": {
        "type": "object",
        "properties": {
          "operation": {
            "enum": [
              "filter",
              "missing",
              "counter",
              "integrate_power",
              "cost",
              "bill",
              "carbon",
              "baseline",
              "compare",
              "normalize",
              "align",
              "solar_balance"
            ]
          },
          "artifact_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-f0-9]{32}$"
            },
            "minItems": 1,
            "maxItems": 2
          },
          "parameters": {
            "type": "object",
            "properties": {
              "timestamp": {
                "type": "string",
                "minLength": 1
              },
              "column": {
                "type": "string",
                "minLength": 1
              },
              "second_timestamp": {
                "type": "string",
                "minLength": 1
              },
              "second_column": {
                "type": "string",
                "minLength": 1
              },
              "second_end": {
                "type": "string",
                "minLength": 1
              },
              "consumption_basis": {
                "enum": [
                  "total_load"
                ]
              },
              "storage_mode": {
                "enum": [
                  "none"
                ]
              },
              "frequency": {
                "enum": [
                  "15min",
                  "30min",
                  "1h",
                  "1D",
                  "daily",
                  "weekly",
                  "monthly"
                ]
              },
              "start": {
                "type": "string",
                "format": "date-time"
              },
              "end": {
                "type": "string"
              },
              "minimum": {
                "type": "number"
              },
              "maximum": {
                "type": "number"
              },
              "window": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "method": {
                "enum": [
                  "left",
                  "trapezoid"
                ]
              },
              "unit": {
                "type": "string",
                "minLength": 1
              },
              "finish": {
                "type": "string",
                "format": "date-time"
              },
              "timezone": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "standing_charge": {
                "type": "object",
                "properties": {
                  "amount_per_day": {
                    "type": "number",
                    "minimum": 0
                  },
                  "currency": {
                    "enum": [
                      "GBP",
                      "USD",
                      "EUR"
                    ]
                  },
                  "taxable": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "amount_per_day",
                  "currency",
                  "taxable"
                ],
                "additionalProperties": false
              },
              "tax": {
                "type": "object",
                "properties": {
                  "rate": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "energy_taxable": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "rate",
                  "energy_taxable"
                ],
                "additionalProperties": false
              }
            },
            "required": [],
            "additionalProperties": false
          }
        },
        "required": [
          "operation",
          "artifact_ids"
        ],
        "additionalProperties": false
      },
      "capabilities": [
        "analyse_timeseries",
        "calculate_energy_cost",
        "calculate_electricity_bill",
        "calculate_carbon",
        "compare_energy_data"
