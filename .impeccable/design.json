  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Main action for a gateway task.",
      "html": "<button class=\"ds-button-primary\" type=\"button\">Use this site</button>",
      "css": ".ds-button-primary{min-height:37px;display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:0 12px;border:1px solid transparent;border-radius:6px;background:var(--green-700);color:#fff;font:650 11px/1.5 var(--font-sans);cursor:pointer;transition:background-color .15s ease,border-color .15s ease,color .15s ease}.ds-button-primary:hover{background:#185f41}.ds-button-primary:focus-visible{outline:3px solid #67b48b;outline-offset:3px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Supporting documentation or secondary action.",
      "html": "<button class=\"ds-button-secondary\" type=\"button\">Open setup guide</button>",
      "css": ".ds-button-secondary{min-height:37px;display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:0 12px;border:1px solid var(--line-strong);border-radius:6px;background:var(--surface);color:var(--pine-800);font:650 11px/1.5 var(--font-sans);cursor:pointer;transition:background-color .15s ease,border-color .15s ease,color .15s ease}.ds-button-secondary:hover{border-color:#97b09c;background:var(--surface-green)}.ds-button-secondary:focus-visible{outline:3px solid #67b48b;outline-offset:3px}"
    },
    {
      "name": "Toolkit Search",
      "kind": "input",
      "refersTo": "search-field",
      "description": "Searches gateway registry names, IDs, descriptions, runtimes, and categories.",
      "html": "<label class=\"ds-search\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"7\"></circle><path d=\"m20 20-4-4\"></path></svg><input type=\"search\" placeholder=\"Search toolkits, categories or runtimes\" aria-label=\"Search toolkits\"></label>",
      "css": ".ds-search{min-height:42px;display:flex;align-items:center;gap:10px;padding:0 11px;border:1px solid var(--line-strong);border-radius:var(--radius-small);background:var(--surface);color:var(--ink-muted)}.ds-search svg{width:17px;height:17px;flex:0 0 auto;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}.ds-search:focus-within{border-color:#80a58b;box-shadow:0 0 0 3px rgba(61,137,85,.1)}.ds-search input{width:100%;min-width:0;height:40px;padding:0;border:0;outline:0;background:transparent;color:var(--ink);font:400 12px/1.5 var(--font-sans)}.ds-search input::placeholder{color:var(--ink-muted);opacity:1}"
    },
    {
      "name": "Category Filter Chip",
      "kind": "chip",
      "refersTo": "filter-chip",
      "description": "Filters registry results; selected state is explicit.",
      "html": "<button class=\"ds-filter-chip\" type=\"button\" aria-pressed=\"true\">forecasting</button>",
      "css": ".ds-filter-chip{min-height:28px;flex:0 0 auto;padding:4px 10px;border:1px solid var(--line);border-radius:999px;background:var(--surface);color:var(--ink-soft);font:400 11px/1.4 var(--font-sans);cursor:pointer;transition:border-color .16s ease,background-color .16s ease,color .16s ease}.ds-filter-chip:hover{border-color:#97b09c;color:var(--pine-900)}.ds-filter-chip[aria-pressed=true]{border-color:#b4d1b8;background:var(--green-100);color:var(--pine-900);font-weight:650}.ds-filter-chip:focus-visible{outline:3px solid #67b48b;outline-offset:3px}"
    },
    {
      "name": "Workspace Navigation Item",
      "kind": "nav",
      "refersTo": "navigation-item",
      "description": "Compact section link with a clear active page.",
      "html": "<button class=\"ds-nav-item\" type=\"button\" aria-current=\"page\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"></rect><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"></rect><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"></rect><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"></rect></svg><span>Connect apps</span></button>",
      "css": ".ds-nav-item{width:100%;min-height:39px;display:flex;align-items:center;gap:11px;padding:0 11px;border:1px solid transparent;border-radius:7px;background:transparent;color:#d2e2d6;text-align:left;font:500 13px/1.4 var(--font-sans);cursor:pointer;transition:background-color .16s ease,color .16s ease,border-color .16s ease}.ds-nav-item svg{width:17px;height:17px;flex:0 0 auto;fill:none;stroke:#afcbbb;stroke-width:1.8}.ds-nav-item:hover{background:rgba(238,247,239,.08);color:#fff}.ds-nav-item[aria-current=page]{border-color:rgba(185,221,194,.13);background:#285443;color:#fff}.ds-nav-item[aria-current=page] svg{stroke:#c8e8ce}.ds-nav-item[aria-current=page]:hover{background:#2d5e49}.ds-nav-item:focus-visible{outline:3px solid #67b48b;outline-offset:3px}"
    },
    {
      "name": "Toolkit Catalogue Row",
      "kind": "custom",
      "refersTo": "toolkit-row",
      "description": "Scannable registry result; selection drives the matching setup detail.",
      "html": "<button class=\"ds-toolkit-row\" type=\"button\" aria-pressed=\"true\"><span class=\"ds-toolkit-name\">Selected toolkit</span><span class=\"ds-runtime\">HTTP</span><span class=\"ds-status-badge\" data-tone=\"good\">stable</span><span class=\"ds-toolkit-action\">View setup →</span></button>",
      "css": ".ds-toolkit-row{width:100%;min-height:74px;display:grid;grid-template-columns:minmax(0,1fr) minmax(72px,.36fr) minmax(110px,.45fr) 74px;align-items:center;gap:12px;padding:12px;border:0;border-top:1px solid var(--line);background:transparent;color:var(--ink);text-align:left;font:400 14px/1.5 var(--font-sans);cursor:pointer;transition:background-color .14s ease}.ds-toolkit-row:hover{background:rgba(255,255,255,.78)}.ds-toolkit-row[aria-pressed=true]{background:var(--surface);box-shadow:inset 0 0 0 1px #d3e4d5}.ds-toolkit-row:focus-visible{outline:3px solid #67b48b;outline-offset:3px}.ds-toolkit-name{overflow:hidden;font-size:13px;font-weight:650;letter-spacing:-.01em;text-overflow:ellipsis;white-space:nowrap}.ds-runtime{color:var(--ink-soft);font-size:11px}.ds-toolkit-action{color:var(--green-700);font-size:11px;font-weight:650;white-space:nowrap}.ds-toolkit-row:hover .ds-toolkit-action{color:var(--pine-900)}"
    },
    {
      "name": "Registry Status Badge",
      "kind": "chip",
      "refersTo": "status-badge-good",
      "description": "Tinted, labeled state for registry readiness and requirements.",
      "html": "<span class=\"ds-status-badge\" data-tone=\"good\">stable</span>",
      "css": ".ds-status-badge{max-width:100%;width:fit-content;display:inline-flex;align-items:center;padding:4px 7px;border-radius:5px;font:650 10px/1.2 var(--font-sans)}.ds-status-badge[data-tone=good]{background:var(--green-100);color:#245d3e}.ds-status-badge[data-tone=caution]{background:var(--amber-100);color:var(--amber-800)}.ds-status-badge[data-tone=neutral]{background:#eef1ed;color:#4d5b51}.ds-status-badge[data-tone=muted]{background:#edf0ed;color:#627067}"
    },
    {
      "name": "Setup Detail Card",
      "kind": "card",
      "refersTo": "setup-card",
      "description": "Gateway-supplied toolkit metadata and provider setup limits.",
      "html": "<aside class=\"ds-setup-card\"><div class=\"ds-card-kicker\">Setup detail<span class=\"ds-state-dot\"></span></div><h3>Selected toolkit</h3><p class=\"ds-description\">Gateway supplied description.</p><dl><div><dt>Toolkit ID</dt><dd><code>toolkit-id</code></dd></div><div><dt>Runtime</dt><dd>HTTP</dd></div><div><dt>Registry status</dt><dd><span class=\"ds-status-badge\" data-tone=\"good\">stable</span></dd></div></dl><p class=\"ds-limit\"><strong>Provider setup</strong><br>Credentials and account onboarding are not available here yet.</p></aside>",
      "css": ".ds-setup-card{min-width:0;padding:18px 18px 19px;border:1px solid var(--line);border-radius:var(--radius-medium);background:var(--surface);color:var(--ink);font-family:var(--font-sans)}.ds-card-kicker{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;color:var(--ink-muted);font-size:10px;font-weight:700;letter-spacing:.09em;text-transform:uppercase}.ds-state-dot{width:8px;height:8px;border-radius:50%;background:#358456}.ds-setup-card h3{margin:0;font-size:19px;font-weight:660;letter-spacing:-.025em;line-height:1.28}.ds-description{margin:8px 0 17px;color:var(--ink-soft);font-size:12px;line-height:1.55}.ds-setup-card dl{margin:0;border-top:1px solid var(--line)}.ds-setup-card dl>div{min-height:36px;display:flex;align-items:flex-start;justify-content:space-between;gap:12px;padding:9px 0;border-bottom:1px solid #edf0ed}.ds-setup-card dt{color:var(--ink-muted);font-size:10px}.ds-setup-card dd{margin:0;color:var(--ink);font-size:10px;font-weight:600;text-align:right;overflow-wrap:anywhere}.ds-setup-card code{color:var(--pine-800);font:500 9px/1.5 var(--font-mono)}.ds-limit{margin:17px 0 0;padding:12px 0 0;border-top:1px solid var(--line);color:var(--ink-soft);font-size:10px;line-height:1.5}.ds-limit strong{color:var(--pine-800)}"
    }
  ],
  "narrative": {
    "northStar": "The Connector Workbench",
    "overview": "This is an operational workbench for developers and energy-system owners connecting energy systems to agents. Daylight setup work should feel steady and precise: a pale neutral canvas carries readable system-ui type, a dark pine rail anchors navigation, and energy green marks actions and useful state.\n\nDense catalogue and gateway metadata stay scannable through ruled rows, small labels, and visible setup details. White surfaces separate related information; compact corners and simple line icons keep the interface technical without making it feel like an enterprise console. Every action and status should reflect what the authenticated gateway supplied.",
    "keyCharacteristics": [
      "Daylight surfaces framed by dark pine navigation.",
      "Compact, factual metadata with quiet dividers and clear status labels.",
      "Selected setup details stay connected to the catalogue choice at every screen size.",
      "Registry and connection states remain grounded in gateway data."
    ],
    "rules": [
      {
        "name": "The Pine Frame Rule",
        "body": "Keep pine on workspace identity and navigation; use green for actions and positive state. Pair caution and error colors with visible labels.",
        "section": "colors"
      },
      {
        "name": "The Metadata Legibility Rule",
        "body": "Keep names and explanations in system UI; reserve monospace for identifiers and configuration.",
        "section": "typography"
      },
      {
        "name": "The Border Before Shadow Rule",
        "body": "Use borders and surface contrast for catalogue structure; reserve ambient shadow for the centered sign-in and status panels.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep gateway-supplied registry metadata visually distinct from connected-account records.",
      "Do label synthetic fixture sites and sample values as synthetic; they are not evidence of a physical installation.",
      "Do keep “View setup” tied to a safe HTTPS guide or a clear provider-onboarding limitation.",
      "Do keep muted text on the canvas or white surface using the `ink-muted` token.",
      "Do keep selected setup details inline on mobile and synchronized with active filters."
    ],
    "donts": [
      "Don't imply that registry metadata means a provider account is connected; provider credentials and account onboarding are not available here yet.",
      "Don't present synthetic site or energy fixtures as physical meter records or verified site data.",
      "Don't use color alone to communicate status, error, selection, or authentication state.",
      "Don't add decorative raster artwork or a component pattern inferred from the missing QUALITY BAR capture card."
    ]
  }
}
