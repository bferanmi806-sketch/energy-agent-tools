# Fixed server-side gateway, never a browser-supplied URL.
ENERGY_GATEWAY_URL=http://127.0.0.1:8765
# Exact external web origin for mutation request checks.
ENERGY_WEB_ORIGIN=http://127.0.0.1:3000
# Generate independently with: node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('hex'))"
ENERGY_WEB_SESSION_KEY=replace-with-64-hex-characters
# Optional external gateway URL for agent setup, including any reverse-proxy prefix.
ENERGY_PUBLIC_GATEWAY_URL=http://127.0.0.1:8765
